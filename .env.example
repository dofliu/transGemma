# ============================================================
# TranslateGemma Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# ── Paths ──
# TG_TEMP_DIR=./temp
# TG_DB_PATH=./history.db
# TG_LOG_DIR=./logs

# ── Ollama / Model ──
# OLLAMA_HOST=http://localhost:11434
# TG_OLLAMA_MODEL=translategemma
# TG_OLLAMA_MEETING_MODEL=qwen3:4b

# ── Gemini (optional cloud backend for meeting summary) ──
# GEMINI_API_KEY=

# ── Server ──
# TG_API_HOST=0.0.0.0
# TG_API_PORT=8000
# GRADIO_SERVER_PORT=7860

# ── Logging ──
# TG_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
# TG_LOG_TO_FILE=true

# ── Feature Flags ──
# TG_ENABLE_TTS=true
# TG_ENABLE_VIDEO=true
# TG_ENABLE_MEETING=true

# ── Limits ──
# TG_MAX_TEXT_LENGTH=50000
# TG_MAX_UPLOAD_MB=150
# TG_MAX_BATCH_SIZE=50
